{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prisme.ai",
  "version": "0.1.0",
  "identifier": "ai.prisme.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Prisme.ai",
        "width": 520,
        "height": 640,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ai.prisme.app"]
      }
    },
    "updater": {
      "endpoints": [
        "https://releases.prisme.ai/desktop/{{target}}/{{arch}}/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwQkU5RTFBQzJEMDhDOEIKUldTTGpORENHcDYrME1nS1VZdVliaGRLSnhmRDI1RksxczZoRFVSb3lmVjM2WkxpVUV3S0hIa2oK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  }
}
