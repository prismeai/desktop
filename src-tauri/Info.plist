<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required so macOS lets the WebView request microphone access for voice
         input (getUserMedia). Without this string the OS silently denies it. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Prisme.ai uses your microphone for voice input.</string>
  </dict>
</plist>
